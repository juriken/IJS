# Global security, privacy and 103 Early Hints Link preloading
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Link: </catalog-index.json>; rel=preload; as=fetch; crossorigin
  Link: </rates.json>; rel=preload; as=fetch; crossorigin
  Link: <https://cdn.tailwindcss.com>; rel=preconnect
  Link: <https://cdnjs.cloudflare.com>; rel=preconnect

# Lightweight catalog summary index (Cloudflare Edge Caching)
/catalog-index.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8

# Japanese Alias Search Index
/search_aliases.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, s-maxage=86400
