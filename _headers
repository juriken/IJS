# Global security, privacy and 103 Early Hints Link preloading
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Link: </catalog-index.json>; rel=preload; as=fetch; crossorigin
  Link: </rates.json>; rel=preload; as=fetch; crossorigin
  Link: <https://cdn.tailwindcss.com>; rel=preconnect
  Link: <https://cdnjs.cloudflare.com>; rel=preconnect

# Lightweight catalog summary index (Cloudflare Edge Caching)
/catalog-index.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8

# Japanese Alias Search Index
/search_aliases.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/json; charset=utf-8

# Full catalog fallback payload
/products.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8

# Schema.org Product JSON-LD Graph
/schema-catalog.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=1800, s-maxage=86400
  Content-Type: application/json; charset=utf-8

# Currency rates cache
/rates.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: application/json; charset=utf-8

# Search engine sitemap
/sitemap.xml
  Cache-Control: public, max-age=1800, s-maxage=7200
  Content-Type: application/xml; charset=utf-8

# RSS Community Release Feed
/feed.xml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=1800, s-maxage=3600
  Content-Type: application/rss+xml; charset=utf-8

# Security.txt RFC Standard
/.well-known/security.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800
  Content-Type: text/plain; charset=utf-8

# Static icons and assets
/*.svg
  Cache-Control: public, max-age=604800, immutable
/*.ico
  Cache-Control: public, max-age=604800, immutable
